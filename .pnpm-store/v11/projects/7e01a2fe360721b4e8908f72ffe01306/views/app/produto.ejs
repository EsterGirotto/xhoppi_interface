<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" type="text/css" href="/css/style.css">
    <link rel="icon" href="/img/logo.png" type="image/png">
    <title>Xhopii - Produto</title>
    <meta name="csrf-token" content="<%= csrf %>">
    <script src="/js/app.js" defer></script>
</head>
<body>

    <header>
        <section id="cabecalho-logo">
            <img src="/img/logo.png">
            <h1>Xhopii</h1>
        </section>
        <section id="cabecalho-logout">
            <a href="/login" data-logout>Sair</a>
        </section>
    </header>

    <nav class="menu-horizontal">
        <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/clientes/cadastrar">Cadastro Cliente</a></li>
            <li><a href="/funcionario/cadastrar">Cadastro Funcionário</a></li>
            <li><a href="/produto/cadastrar">Cadastro Produto</a></li>
            <li><a href="/clientes">Ver Clientes</a></li>
            <li><a href="/funcionarios">Ver Funcionários</a></li>
            <li><a href="/produtos">Ver Produtos</a></li>
        </ul>
    </nav>

<main>
<section class="produto-imagem"><section class="produto-principal"><img src="<%= produto.imagem %>" alt="<%= produto.nome %>"></section></section>
<section class="produto-detalhes"><h1><%= produto.nome %></h1><p><%= produto.descricao %></p><p>Fabricante: <%= produto.marca %></p><p id="precoProduto"><%= dinheiro(produto.preco) %></p><p><%= produto.quantidade %> disponíveis</p>
<form method="post" action="/compras" data-compra><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="codigo" value="<%= produto.codigo %>"><input type="hidden" name="chave" value="<%= chave %>">
<label for="quantidade">Quantidade</label><input class="botao" id="quantidade" type="number" name="quantidade" value="1" min="1" max="<%= Math.max(1,Math.min(produto.quantidade,999)) %>" required>
<label for="cupom">Cupom (opcional): XHOPII10</label><input class="botao" id="cupom" name="cupom" maxlength="30">
<label for="pagamento">Pagamento simulado</label><select id="pagamento" name="pagamento"><option value="aprovado">Aprovado</option><option value="recusado">Recusado</option></select>
<button id="botaoComprar" <%= produto.quantidade ? '' : 'disabled' %>><%= produto.quantidade ? 'Simular compra' : 'Produto esgotado' %></button><p data-status>Compra acadêmica, sem cobrança real.</p></form>
<p><a href="/pedidos">Meus pedidos</a> | <a href="/produtos">Voltar aos produtos</a></p>
<% if(usuario.papel === 'admin') { %><p><a href="/produtos/<%= produto.codigo %>/editar">Editar produto</a></p><form method="post" action="/produtos/<%= produto.codigo %>/excluir" data-confirm="Excluir este produto?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Excluir produto</button></form><% } %></section>
<!-- O CSS original usa float e altura fixa; a quebra limpa as colunas antes do rodapé. -->
<br clear="all">
</main>
    <footer class="rodape">
        <section class="conteudo-rodape-info">
            <section class="conteudo-rodape">
                <h5 id="rodape-titulo">Atendimento ao cliente</h5>
                <a href="#">Central de Ajuda</a>
                <a href="#">Como Comprar</a>
                <a href="#">Métodos de Paramento</a>
                <a href="#">Garantia Xhopii</a>
                <a href="#">Devolução e Reembolso</a>
                <a href="#">Fale Conosco</a>
                <a href="#">Ouridoria</a>
                <a href="#">Preferências de cookies</a>
            </section>
            <section class="conteudo-rodape">
                <h5 id="rodape-titulo">Sobre a Xhopii</h5>
                <a href="#">Sobre Nós</a>
                <a href="#">Políticas Xhopii</a>
                <a href="#">Política de Privacidade</a>
                <a href="#">Programa de Ailiados da Xhopii</a>
                <a href="#">Seja um Entregador Xhopii</a>
                <a href="#">Ofertas Relâmpago</a>
                <a href="#">Xhopii Blog</a>
                <a href="#">Impresa</a>
            </section>
            <section class="conteudo-rodape">
                <h5 id="rodape-titulo">Pagamento</h5>
                <section class="conteudo-rodape-pagamento">
                    <img id="img-pagamento" src="/img/logo-visa.png">
                    <img id="img-pagamento" src="/img/logo-mastercard.png">
                    <img id="img-pagamento" src="/img/logo-hipercard.png">
                    <img id="img-pagamento" src="/img/logo-elo.png">
                    <img id="img-pagamento" src="/img/logo-american-express.png">
                    <img id="img-pagamento" src="/img/logo-boleto.png">
                    <img id="img-pagamento" src="/img/logo-pix.png">
                </section>               
            </section>
            <section class="conteudo-rodape">
                <h5 id="rodape-titulo">Siga-nos</h5>
                <a href="#"><img id="img-sociais" src="/img/logo-instagram.png">Instagram</a>
                <a href="#"><img id="img-sociais" src="/img/logo-tiktok.png">Tik Tok</a>
                <a href="#"><img id="img-sociais" src="/img/logo-twitter.png">X/Twitter</a>
                <a href="#"><img id="img-sociais" src="/img/logo-facebook.png">Facebook</a>
                <a href="#"><img id="img-sociais" src="/img/logo-linkedln.png">Linkedln</a>
            </section>
            <section class="conteudo-rodape">
                <h5 id="rodape-titulo">Atendimento ao cliente</h5>
                <img id="img-store" src="/img/qr-code.png">
                <img id="img-store" src="/img/logo-store-apple.png">
                <img id="img-store" src="/img/logo-google-play.png">
            </section>
        </section>
        <hr>
        <p>© 2025 Xhopii. Todos os direitos acadêmicos reservados</p>
    </footer>

</body>
</html>